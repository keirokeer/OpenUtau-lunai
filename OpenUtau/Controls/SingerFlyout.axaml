<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OpenUtau.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="400"
             x:Class="OpenUtau.App.Controls.SingerFlyout"
             x:DataType="vm:SingerFlyoutViewModel">
  <UserControl.Resources>
    <SolidColorBrush x:Key="FavoriteStarBrush" Color="#FFC107"/>
    <StreamGeometry x:Key="StarOutlineGeometry">M7.00,8.91L4.50,10.42L5.16,7.57L2.95,5.65L5.86,5.41L7.00,2.72L8.14,5.41L11.05,5.65L8.84,7.57L9.50,10.42M13.65,4.82L8.87,4.40L7.00,0.00L5.13,4.40L0.35,4.82L3.97,7.96L2.89,12.64L7.00,10.16L11.11,12.64L10.02,7.96L13.65,4.82Z</StreamGeometry>
    <StreamGeometry x:Key="StarFilledGeometry">M7.00,10.16L11.11,12.64L10.02,7.96L13.65,4.82L8.87,4.40L7.00,0.00L5.13,4.40L0.35,4.82L3.97,7.96L2.89,12.64L7.00,10.16Z</StreamGeometry>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.singerTile">
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="ToolTip.Placement" Value="Right"/>
      <Setter Property="ToolTip.HorizontalOffset" Value="8"/>
      <Setter Property="ToolTip.VerticalOffset" Value="0"/>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}"/>
      </Style>
      <Style Selector="^.current">
        <Setter Property="Background" Value="{DynamicResource SelectedTrackAccentLightBrushSemi}"/>
      </Style>
      <Style Selector="^.current:pointerover">
        <Setter Property="Background" Value="{DynamicResource SelectedTrackAccentLightBrushSemi}"/>
      </Style>
      <Style Selector="^.missing Border.avatar, ^.missing TextBlock">
        <Setter Property="Opacity" Value="0.5"/>
      </Style>
    </Style>
    <Style Selector="Border.favStar">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Margin" Value="0,-4,-4,0"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource NeutralAccentBrushSemi}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="ToolTip.Placement" Value="Top"/>
      <Setter Property="ToolTip.VerticalOffset" Value="-6"/>
      <Style Selector="^ > Path">
        <Setter Property="Fill" Value="{StaticResource FavoriteStarBrush}"/>
        <Setter Property="Data" Value="{StaticResource StarOutlineGeometry}"/>
      </Style>
      <Style Selector="^.on">
        <Setter Property="Opacity" Value="1"/>
      </Style>
      <Style Selector="^.on > Path">
        <Setter Property="Data" Value="{StaticResource StarFilledGeometry}"/>
      </Style>
    </Style>
    <Style Selector="Border.singerTile:pointerover Border.favStar">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="TextBox.singerSearch">
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource MutedIconBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ToggleButton.typeFilter">
      <Setter Property="Height" Value="22"/>
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource NeutralAccentBrushSemi}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <!-- Keep outline on hover (Fluent otherwise clears BorderBrush). -->
      <Style Selector="^:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource NeutralAccentBrushSemi}"/>
      </Style>
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NeutralAccentBrushSemi}"/>
        <Setter Property="BorderThickness" Value="1"/>
      </Style>
      <!-- Checked: no border (clean corners). Extra padding replaces the 1px border so text stays put. -->
      <Style Selector="^:checked">
        <Setter Property="Foreground" Value="{DynamicResource WhiteKeyNameBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="7,1"/>
      </Style>
      <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NeutralAccentBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="7,1"/>
        <Setter Property="Foreground" Value="{DynamicResource WhiteKeyNameBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>
      <Style Selector="^:checked:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource WhiteKeyNameBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="7,1"/>
      </Style>
      <Style Selector="^:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NeutralAccentBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="7,1"/>
        <Setter Property="Foreground" Value="{DynamicResource WhiteKeyNameBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>
    </Style>
    <Style Selector="Button.footer">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="1"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <!-- Above the button so the tip never sits on the cursor / blocks clicks. -->
      <Setter Property="ToolTip.Placement" Value="Top"/>
      <Setter Property="ToolTip.HorizontalOffset" Value="0"/>
      <Setter Property="ToolTip.VerticalOffset" Value="-8"/>
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NeutralAccentBrush}"/>
      </Style>
      <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NeutralAccentBrushPointerOver}"/>
      </Style>
      <Style Selector="^ Viewbox">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
      </Style>
      <Style Selector="^ Canvas">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
      </Style>
      <Style Selector="^ Path">
        <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
      </Style>
      <!-- Dark glyph on NeutralAccent hover fill (same pair as checkbox hover). -->
      <Style Selector="^:pointerover Path">
        <Setter Property="Fill" Value="{DynamicResource WhiteKeyNameBrush}"/>
      </Style>
      <Style Selector="^:pressed Path">
        <Setter Property="Fill" Value="{DynamicResource WhiteKeyNameBrush}"/>
      </Style>
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,4,0,0"
            BorderBrush="{DynamicResource NeutralAccentBrushSemi}">
      <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button Classes="footer" ToolTip.Tip="{DynamicResource tracks.installsinger}" Command="{Binding InstallSinger}">
          <Viewbox><Canvas>
            <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
          </Canvas></Viewbox>
        </Button>
        <Button Classes="footer" ToolTip.Tip="{DynamicResource tracks.opensingers}" Command="{Binding OpenSingersFolder}">
          <Viewbox><Canvas>
            <Path Data="M20,18H4V8H20M20,6H12L10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6Z"/>
          </Canvas></Viewbox>
        </Button>
        <Button Classes="footer" ToolTip.Tip="{DynamicResource tracks.openaddsingers}" Command="{Binding OpenAdditionalSingersFolder}"
                IsVisible="{Binding HasAdditionalSingersFolder}">
          <Viewbox><Canvas>
            <Path Data="M12,12H14V10H16V12H18V14H16V16H14V14H12V12M22,8V18C22,19.11 21.11,20 20,20H4C2.89,20 2,19.11 2,18V6C2,4.89 2.89,4 4,4H10L12,6H20C21.11,6 22,6.89 22,8M20,8H4V18H20V8Z"/>
          </Canvas></Viewbox>
        </Button>
        <Button Classes="footer" ToolTip.Tip="{DynamicResource singers.refresh}" Command="{Binding RefreshSingers}">
          <Viewbox><Canvas>
            <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
          </Canvas></Viewbox>
        </Button>
      </StackPanel>
    </Border>
    <TextBox Name="SearchBox" DockPanel.Dock="Top" Classes="singerSearch"
             Text="{Binding SearchText}" PlaceholderText="{DynamicResource lunai.search}"/>
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding TypeFilters}" Margin="0,0,0,4">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:SingerTypeFilterViewModel">
          <ToggleButton Classes="typeFilter" Content="{Binding Label}"
                        IsChecked="{Binding IsSelected, Mode=OneWay}"
                        Click="TypeFilterClicked"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Panel>
      <TextBlock IsVisible="{Binding IsEmpty}" Margin="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Text="{DynamicResource tracks.nosinger}"/>
      <ScrollViewer Name="TileScroller" IsVisible="{Binding !IsEmpty}"
                    Classes="workspaceScroll workspaceDockPanelScroll tightOverlayInset"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                    AllowAutoHide="False">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.DataTemplates>
            <DataTemplate DataType="vm:SingerFlyoutSeparatorViewModel">
              <Border Height="8" Margin="4,2" Background="Transparent" IsHitTestVisible="False">
                <Border Height="1" VerticalAlignment="Center"
                        Background="{DynamicResource NeutralAccentBrushSemi}"/>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:SingerTileViewModel">
              <Border Classes="singerTile"
                      Classes.current="{Binding IsCurrent}"
                      Classes.missing="{Binding IsMissing}"
                      ToolTip.Tip="{Binding Tip}"
                      PointerPressed="TilePressed" PointerReleased="TileReleased"
                      ContextRequested="TileContextRequested">
                <DockPanel>
                  <Panel DockPanel.Dock="Left" Width="32" Height="32">
                    <Border Classes="avatar" Width="32" Height="32"
                            CornerRadius="4" ClipToBounds="True"
                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                      <Image Source="{Binding Avatar}" Stretch="UniformToFill"
                             RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    </Border>
                    <Border Classes="favStar" Classes.on="{Binding IsFavourite}" IsVisible="{Binding !IsMissing}"
                            ToolTip.Tip="{DynamicResource tracks.favorite}" PointerPressed="FavStarPressed">
                      <Path/>
                    </Border>
                  </Panel>
                  <TextBlock Margin="6,0,2,0" Text="{Binding Name}"
                             TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>

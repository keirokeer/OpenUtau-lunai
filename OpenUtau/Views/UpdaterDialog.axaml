<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="OpenUtau.App.Views.UpdaterDialog"
        Width="480" MinHeight="360" MaxHeight="640" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/open-utau.ico"
        Title="{DynamicResource updater.caption}" Closing="OnClosing">
  <Grid Margin="24,20,24,24" RowDefinitions="Auto,*,Auto">
    <StackPanel Grid.Row="0" Spacing="8" HorizontalAlignment="Center">
      <Image Width="110" Height="110" HorizontalAlignment="Center"
             Source="/Assets/open-utau.ico"/>
      <Image Height="60" HorizontalAlignment="Center" Margin="0,8,0,0"
             Source="/Assets/logotype.png" IsVisible="{Binding !IsDarkMode}"/>
      <Image Height="60" HorizontalAlignment="Center" Margin="0,8,0,0"
             Source="/Assets/logotype-w.png" IsVisible="{Binding IsDarkMode}"/>
      <TextBlock Margin="0,8,0,0" TextAlignment="Center"
                 Text="{Binding AppVersion}"/>
      <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                 Text="{DynamicResource updater.description}"/>
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,16,0,16" RowDefinitions="Auto,*">
      <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontWeight="Bold"
                 Text="{Binding UpdaterStatus}"/>
      <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,10"
              Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
              CornerRadius="6" MaxHeight="220"
              IsVisible="{Binding HasReleaseNotes}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="6">
            <TextBlock FontWeight="SemiBold"
                       Text="{DynamicResource updater.releasenotes}"/>
            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.9"
                       Text="{Binding ReleaseNotes}"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
      <Button Width="120" Content="{DynamicResource updater.github}" Command="{Binding OnGithub}"/>
      <Button Width="120" Content="{DynamicResource updater.update}" Command="{Binding OnUpdate}"
              IsEnabled="{Binding UpdateAvailable}"
              FontWeight="{Binding UpdateButtonFontWeight}"/>
    </StackPanel>
  </Grid>
</Window>

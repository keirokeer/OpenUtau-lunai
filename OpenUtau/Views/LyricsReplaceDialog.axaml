<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="using:OpenUtau.App.Controls"
        mc:Ignorable="d" MinWidth="200" MinHeight="200" Width="300" Height="350"
        x:Class="OpenUtau.App.Views.LyricsReplaceDialog"  WindowStartupLocation="CenterOwner"
        Icon="/Assets/open-utau.ico"
        Title="{DynamicResource lyricsreplace.replace}">
  <Window.Styles>
    <StyleInclude Source="/Styles/PianoRollStyles.axaml"/>
  </Window.Styles>
  <Grid Margin="10" RowDefinitions="auto,10,Auto,10,Auto,10,*,10,Auto">
    <StackPanel Orientation="Horizontal" Grid.Row="0">
      <TextBlock Text="{DynamicResource lyricsreplace.before}" />
      <c:WorkspacePanelTextBox Text="{Binding OldValue}" Classes="workspacePanelTextBox" MinWidth="200" Margin="10,0"
               Watermark="{DynamicResource lyricsreplace.regex}"/>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Grid.Row="2">
      <TextBlock Text="{DynamicResource lyricsreplace.after}" />
      <c:WorkspacePanelTextBox Text="{Binding NewValue}" Classes="workspacePanelTextBox" MinWidth="200" Margin="10,0" />
    </StackPanel>

    <StackPanel Grid.Row="4">
      <TextBlock Text="{DynamicResource lyricsreplace.preview}" />
      <TextBlock Text="{Binding Preview}" Margin="5" MinHeight="15" />
    </StackPanel>

    <StackPanel Grid.Row="6">
      <TextBlock Text="{DynamicResource lyricsreplace.presets}" />
      <ListBox ItemsSource="{Binding PresetList}"
               SelectedItem="{Binding SelectedPreset}"
               SelectionMode="Single" Margin="5" />
    </StackPanel>

    <StackPanel Grid.Row="8" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
      <Button Content="{DynamicResource button.apply}" Margin="0" MinWidth="50" Classes="dialogPrimary" Click="OnFinish"/>
    </StackPanel>
  </Grid>
</Window>

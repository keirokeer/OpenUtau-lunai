<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:OpenUtau.App.ViewModels"
             xmlns:c="using:OpenUtau.App.Controls"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="600"
             x:Class="OpenUtau.App.Views.ExpressionDefaultsPane"
             x:Name="ExpressionDefaultsRoot">
  <UserControl.Styles>
    <Style Selector="TextBlock.expDefaultLabel">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Border.expDefaultLabelHit">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Border.expDefaultLabelHit:pointerover">
      <Setter Property="Background" Value="{DynamicResource TransportToolbarOffHoverBrush}"/>
    </Style>
    <Style Selector="TextBlock.expDefaultValue">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="FontFamily" Value="monospace"/>
      <Setter Property="MinWidth" Value="36"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="TextBlock.expDefaultUnit">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="Opacity" Value="0.75"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Slider.fader">
      <Setter Property="Focusable" Value="True"/>
    </Style>
    <Style Selector="Grid.expDefaultRow">
      <!-- Vertical gap comes from ItemsControl panel Spacing, not row margins. -->
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="Grid.expDefaultSliderRow">
      <Setter Property="Margin" Value="0,0,-10,0"/>
    </Style>
    <!-- Same typography as expDefaultLabel; only Foreground differs (M/S/fx off brush). -->
    <Style Selector="TextBlock.expDefaultLabelOrdinal">
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextTrimming" Value="None"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,5,0"/>
      <Setter Property="Foreground" Value="{DynamicResource TransportChipIconOffBrush}"/>
    </Style>
    <!-- Must live here (UserControl.Styles beat App styles on popup descendants). -->
    <Style Selector="ComboBoxItem:selected TextBlock.expDefaultLabelOrdinal,
                     ComboBoxItem:selected:pointerover TextBlock.expDefaultLabelOrdinal">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
    </Style>
    <!-- Spacing between parameter / voice-color rows (ItemsControl children). -->
    <Style Selector="ItemsControl.expDefaultItemList">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Classes="expDefaultItemListPanel"/>
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="StackPanel.expDefaultItemListPanel">
      <Setter Property="Spacing" Value="12"/>
    </Style>
    <Style Selector="StackPanel.expDefaultSectionContent">
      <Setter Property="Spacing" Value="8"/>
    </Style>
    <Style Selector="Border.expModeTab">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="2,4"/>
      <Setter Property="Margin" Value="0,0,14,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style Selector="Border.expModeTab:disabled">
      <Setter Property="Opacity" Value="0.35"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="Border.expModeTab TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Opacity" Value="0.5"/>
    </Style>
    <Style Selector="Border.expModeTab.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
    </Style>
    <Style Selector="Border.expModeTab.selected TextBlock">
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.expTrackSubtitle">
      <Setter Property="Opacity" Value="0.55"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="2,2,0,0"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Border.expStyleChip">
      <Setter Property="Padding" Value="7,3"/>
      <Setter Property="Margin" Value="0,0,4,4"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
      <Setter Property="Background" Value="{DynamicResource WorkspaceCardBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="24"/>
    </Style>
    <Style Selector="Border.expStyleChip:pointerover">
      <Setter Property="Background" Value="{DynamicResource TransportToolbarOffHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorDark1Brush}"/>
    </Style>
    <Style Selector="Border.expStyleChip TextBlock.expStyleChipName">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="MaxWidth" Value="120"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.expStyleChipDelete">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinWidth" Value="16"/>
      <Setter Property="MinHeight" Value="16"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="Border.expStyleChip:pointerover Button.expStyleChipDelete">
      <Setter Property="Opacity" Value="0.85"/>
    </Style>
  </UserControl.Styles>
  <Design.DataContext>
    <vm:ExpressionDefaultsViewModel/>
  </Design.DataContext>
  <Grid RowDefinitions="Auto,*">
    <Grid Grid.Row="0" Margin="16,12,40,8" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="{Binding PanelTitle}" Classes="notePropsPanelTitle"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <Border Classes="expModeTab"
                  Classes.selected="{Binding !IsTrackMode}"
                  PointerPressed="OnProjectModePressed">
            <TextBlock Text="{DynamicResource workspace.panel.expressions.mode.project}"/>
          </Border>
          <Border x:Name="TrackModeTab"
                  Classes="expModeTab"
                  Classes.selected="{Binding IsTrackMode}"
                  IsEnabled="{Binding CanUseTrackMode}"
                  PointerPressed="OnTrackModePressed">
            <TextBlock Text="{DynamicResource workspace.panel.expressions.mode.track}"/>
          </Border>
        </StackPanel>
        <TextBlock Classes="expTrackSubtitle"
                   Text="{Binding TrackSubtitle}"
                   IsVisible="{Binding HasTrackSubtitle}"/>
      </StackPanel>
      <Button x:Name="ClosePanelButton" Grid.Column="1" Classes="workspacePanelClose"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-8,0"
              IsVisible="False" Click="OnCloseDockedPanel"
              ToolTip.Tip="{DynamicResource workspace.panel.close}">
        <Path Classes="stroked"/>
      </Button>
    </Grid>
    <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Classes="workspaceScroll workspaceDockPanelScroll"
                  Margin="10,0,10,16"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                  AllowAutoHide="False">
      <StackPanel Classes="workspacePanelSections" Margin="0" HorizontalAlignment="Stretch">
        <Button HorizontalAlignment="Stretch" Margin="0,0,0,8"
                IsVisible="{Binding IsTrackMode}"
                IsEnabled="{Binding HasTrackOverrides}"
                Click="OnClearTrackOverridesClick"
                Content="{DynamicResource workspace.panel.expressions.track.clear}"
                ToolTip.Tip="{DynamicResource workspace.panel.expressions.track.clear.tip}"/>
        <Separator Classes="workspacePanelSectionDivider"/>
        <Expander Classes="workspacePanelSectionExpander" IsExpanded="True"
                  IsVisible="{Binding HasParameters}"
                  Header="{DynamicResource workspace.panel.expressions.parameters}">
          <StackPanel Classes="expDefaultSectionContent">
            <ItemsControl Classes="expDefaultItemList" ItemsSource="{Binding ParameterItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ExpressionDefaultItem">
                  <Grid Classes="expDefaultRow expDefaultSliderRow" ColumnDefinitions="110,*,Auto">
                    <Border Classes="expDefaultLabelHit" Grid.Column="0"
                            ToolTip.Tip="{DynamicResource workspace.panel.expressions.openinexppanel}"
                            PointerPressed="OnParameterNamePressed">
                      <DockPanel LastChildFill="True">
                        <Ellipse DockPanel.Dock="Left" Width="6" Height="6"
                                 Margin="0,4,4,0" VerticalAlignment="Top"
                                 IsVisible="{Binding HasTrackOverride}"
                                 Fill="{DynamicResource SystemAccentColorDark1Brush}"/>
                        <TextBlock Classes="expDefaultLabel" Text="{Binding Name}"/>
                      </DockPanel>
                    </Border>
                    <c:ExpressionDefaultSlider Grid.Column="1" Item="{Binding}"/>
                    <TextBlock Classes="expDefaultValue" Grid.Column="2"
                               Text="{Binding DefaultValue, StringFormat={}{0:0}}"
                               PointerPressed="OnDefaultValuePressed"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>
        <Separator Classes="workspacePanelSectionDivider" IsVisible="{Binding HasVoiceColors}"/>
        <Expander Classes="workspacePanelSectionExpander" IsExpanded="True"
                  IsVisible="{Binding HasVoiceColors}"
                  Header="{DynamicResource workspace.panel.expressions.voicecolors}">
          <StackPanel Classes="expDefaultSectionContent">
            <Grid Classes="expDefaultRow" ColumnDefinitions="*,Auto" Margin="0,0,0,0">
              <TextBlock Classes="expDefaultLabel" Margin="4,0,8,0"
                         Text="{DynamicResource workspace.panel.expressions.voicecolormax}"
                         TextWrapping="Wrap" Grid.Column="0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <c:WorkspacePanelTextBox Classes="workspacePanelTextBox" Width="56"
                                         Text="{Binding VoiceColorCurveMaxText}"
                                         VerticalAlignment="Center"/>
                <TextBlock Classes="expDefaultUnit" Text="%"/>
              </StackPanel>
            </Grid>
            <ItemsControl Classes="expDefaultItemList" ItemsSource="{Binding VoiceColorItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ExpressionDefaultItem">
                  <Grid Classes="expDefaultRow expDefaultSliderRow"
                        ColumnDefinitions="110,*,Auto">
                    <DockPanel Grid.Column="0" LastChildFill="True" VerticalAlignment="Center">
                      <TextBlock DockPanel.Dock="Right"
                                 Text="?"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Opacity="0.75"
                                 Cursor="Help"
                                 IsVisible="{Binding HasTip}"
                                 ToolTip.Tip="{Binding Tip}"
                                 Foreground="{DynamicResource MutedIconBrush}"/>
                      <Border Classes="expDefaultLabelHit"
                              ToolTip.Tip="{DynamicResource workspace.panel.expressions.openinexppanel}"
                              PointerPressed="OnParameterNamePressed">
                        <DockPanel LastChildFill="True">
                          <Ellipse DockPanel.Dock="Left" Width="6" Height="6"
                                   Margin="0,4,4,0" VerticalAlignment="Top"
                                   IsVisible="{Binding HasTrackOverride}"
                                   Fill="{DynamicResource SystemAccentColorDark1Brush}"/>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="expDefaultLabelOrdinal"
                                       Text="{Binding NameOrdinal}"
                                       IsVisible="{Binding HasNameOrdinal}"/>
                            <TextBlock Classes="expDefaultLabel" Text="{Binding NameBody}"
                                       TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DockPanel>
                    <c:ExpressionDefaultSlider Grid.Column="1" Item="{Binding}"
                                               IsVisible="{Binding ShowMixSlider}"
                                               VerticalAlignment="Center"/>
                    <TextBlock Classes="expDefaultValue" Grid.Column="2"
                               Text="{Binding DefaultValue, StringFormat={}{0:0}}"
                               IsVisible="{Binding ShowMixSlider}"
                               PointerPressed="OnDefaultValuePressed"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Classes="expDefaultRow" ColumnDefinitions="110,*" Margin="0,0,0,0"
                  IsVisible="{Binding ShowDefaultVoiceColorPicker}">
              <TextBlock Classes="expDefaultLabel" Margin="4,0,8,0"
                         Text="{DynamicResource workspace.panel.expressions.defaultcolor}"
                         TextWrapping="Wrap"
                         Grid.Column="0"/>
              <c:WorkspacePanelComboBox Grid.Column="1" Classes="workspacePanelCombo"
                                        ItemsSource="{Binding VoiceColorOptions}"
                                        SelectedIndex="{Binding SelectedVoiceColorIndex}">
                <c:WorkspacePanelComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:VoiceColorOptionItem">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Classes="expDefaultLabelOrdinal"
                                 Text="{Binding NameOrdinal}"
                                 IsVisible="{Binding HasNameOrdinal}"/>
                      <TextBlock Classes="expDefaultLabel"
                                 Text="{Binding NameBody}"
                                 TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </DataTemplate>
                </c:WorkspacePanelComboBox.ItemTemplate>
              </c:WorkspacePanelComboBox>
            </Grid>
          </StackPanel>
        </Expander>

        <Separator Classes="workspacePanelSectionDivider"/>
        <Expander Classes="workspacePanelSectionExpander" IsExpanded="True"
                  Header="{DynamicResource workspace.panel.expressions.styles}">
          <StackPanel Classes="expDefaultSectionContent" Spacing="6">
            <TextBlock Opacity="0.55" FontSize="11" TextWrapping="Wrap"
                       Text="{DynamicResource workspace.panel.expressions.styles.projecthint}"/>
            <Button HorizontalAlignment="Stretch"
                    IsEnabled="{Binding CanSaveStyle}"
                    Click="OnSaveStyleClick"
                    Content="{DynamicResource workspace.panel.expressions.styles.save}"
                    ToolTip.Tip="{DynamicResource workspace.panel.expressions.styles.save.tip}"/>
            <TextBlock Opacity="0.55" FontSize="11" TextWrapping="Wrap"
                       IsVisible="{Binding !HasStyles}"
                       Text="{DynamicResource workspace.panel.expressions.styles.empty.list}"/>
            <ItemsControl ItemsSource="{Binding StyleItems}" IsVisible="{Binding HasStyles}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ExpressionStyleItemViewModel">
                  <Border Classes="expStyleChip"
                          ToolTip.Tip="{Binding ToolTipText}"
                          PointerPressed="OnStyleChipPointerPressed">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                      <TextBlock Classes="expStyleChipName" Text="{Binding Name}"/>
                      <Button Classes="iconButton expStyleChipDelete"
                              Click="OnStyleDeleteClick"
                              ToolTip.Tip="{DynamicResource workspace.panel.expressions.styles.delete}">
                        <Viewbox Width="10" Height="10">
                          <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                        </Viewbox>
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
